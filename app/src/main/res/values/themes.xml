<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Stemflow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.Stemflow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/splash_gradient</item>
        <item name="postSplashScreenTheme">@style/Theme.Stemflow</item>
    </style>
</resources>
